# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no git — ele contém o segredo do Azure AD.

# ID do tenant (mesmo do dashboard)
AZURE_TENANT_ID=59190e65-5cad-4885-9f2d-77a59385667b

# ID do NOVO app registrado no Azure AD para o sync (não é o mesmo do dashboard)
AZURE_CLIENT_ID=

# Segredo do cliente gerado em "Certificados e segredos"
AZURE_CLIENT_SECRET=

# E-mail da caixa compartilhada que recebe o relatório do ERP
SHARED_MAILBOX=
